  "info": {
    "_postman_id": "05384b7b-1e0b-48d0-8173-5ef3bd9bbd9a",
    "name": "Gemnote Gifts API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Gemnote API lets partners send custom gifts and greeting cards programmatically and track their shipments. Responses follow a JSON:API-style envelope (data / type / attributes / relationships, with links + meta for pagination). Authentication is a token issued by your Gemnote account manager, passed in the AUTHORIZATION header. A sandbox environment (https://sandbox.gemnote.com/) mirrors production for safe testing; sandbox tokens begin with `t_` and production tokens begin with `p_`.\n\nContact Support:\n Name: Gemnote",
      "type": "text/plain"
    }
  }
